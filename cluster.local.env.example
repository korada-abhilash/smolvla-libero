# Copy to cluster.local.env (git-ignored) and fill in for your machine.
REMOTE_HOST=my-login-host          # ssh host alias of the SLURM login node
REMOTE_DIR=/path/to/workdir/smolvla-libero
CONDA_ROOT=/path/to/miniconda3
SLURM_PARTITION=gpu
SLURM_SETUP="module load slurm"    # anything needed before sbatch/srun works
